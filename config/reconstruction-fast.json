{
  // 快速重建配置：针对 DensifyPointCloud / TextureMesh 瓶颈优化。

  // ========== Inputs ==========
  "images": "data/images",
  "cameras": "data/cameras.json",
  "output": "outputs/run",

  // ========== Runtime ==========
  "colmap": "build/third_party/colmap/src/colmap/exe/colmap",
  "openmvs_bin": "build/third_party/openmvs/bin",
  "max_threads": 12,
  "reuse_existing": false,
  "cuda_device": -1,

  // ========== COLMAP: matcher ==========
  "matcher": "exhaustive",
  "sequential_overlap": 10,
  "sequential_quadratic_overlap": true,

  // ========== COLMAP: mapper ==========
  "mapper_ba_use_gpu": false,

  // ========== COLMAP: image_undistorter ==========
  "undistort_copy_policy": "HARD_LINK",

  // ========== OpenMVS: DensifyPointCloud ==========
  "remove_depth_maps": true,

  // 深度图估计邻居视图数：5 -> 4
  // 影响：每张深度图少处理 1 个视角，DensifyPointCloud 约快 15-20%
  "densify_number_views": 4,

  // 深度图融合最小一致性视图数：保持 2（质量底线）
  "densify_number_views_fuse": 2,

  // PatchMatch 几何一致性迭代：保持 1
  "densify_geometric_iters": 1,

  // 深度图分辨率级别：保持 1
  "densify_resolution_level": 1,

  // 深度图最大分辨率：2560 -> 2048
  // 影响：输入点云密度降低，网格面数减少，TextureMesh face assignment 相应加速
  "densify_max_resolution": 2048,

  // 深度图估计迭代次数：3 -> 2
  "densify_iters": 2,

  // ========== OpenMVS: TextureMesh ==========
  "generate_texture": true,

  // 纹理 patch packing 启发式：3 -> 100
  // 100 = 快速贪心；质量：纹理图集利用率略降，但视觉效果通常接近
  "texture_patch_packing_heuristic": 100,

  // 关闭 seam leveling，避免在高对比标定板数据上产生饱和 RGB/CMY 色块。
  "texture_global_seam_leveling": false,
  "texture_local_seam_leveling": false
}
